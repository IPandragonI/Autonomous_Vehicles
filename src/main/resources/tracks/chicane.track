# Track n°3: fast loop with a chicane on each straight (driven counter-clockwise).
name chicane
width 14
samples 12
checkpoints 30

point -110 -50
point  -70 -50
point  -40 -41
point  -10 -41
point   20 -50
point  110 -50
point  140   0
point  110  50
point   50  50
point   20  41
point  -10  41
point  -40  50
point -110  50
point -140   0
